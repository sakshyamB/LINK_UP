generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique 
  email            String   @unique
  password         String?
  profilePicture   String?
  coverPicture     String?
  createdAt        DateTime @default(now())
  posts            Post[]
}

model Post {
  id        String   @id @default(uuid())
  caption   String?
  imageUrl  String?
  authorId  String
  author    User
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id              String   @id @default(uuid())
  commentedText   String
  commenterId     String
  commenter       User
  postId          String
  post            Post
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Like {
  id           String   @id @default(uuid())
  likedById    String
  likedBy      User
  postId       String
  post         Post
  likedAt      DateTime @default(now())
}

model FriendRequest {
  id            String     @id @default(uuid())
  requesterId   String
  requester     User
  recieverId    String
  reciever      User
  status        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Conversation {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ConversationParticipants {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
}

model Message {
  id              String      @id @default(uuid())
  text            String     
  conversationId  String
  conversation    Conversation
  senderId        String
  recieverId      String
  sendAt          DateTime    @default(now())
  editedAt        DateTime    @updatedAt
}

model Notification {
  id                String    @id @default(uuid())
  message           String
  recieverId    String
  reciever      User         
  createdAt DateTime @default(now())
}
